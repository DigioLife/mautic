# ==============================================
# MARKETFLOW ENVIRONMENT CONFIGURATION
# ==============================================
# Vars marked [ACTIVE] are read by code today. Vars marked [PHASE 2] are
# placeholders for modules not built yet (contacts/email/sms/telegram bot
# sending, etc.) — safe to leave blank until those land, but keep the names
# so Phase 2 code can pick them up without another env audit.

# ==============================================
# DATABASE  [ACTIVE — read by Prisma via schema.prisma]
# ==============================================
DATABASE_URL="postgresql://marketflow:marketflow_password@localhost:5432/marketflow"

# ==============================================
# REDIS  [PHASE 2 — cache + BullMQ queue, not wired yet]
# ==============================================
REDIS_URL="redis://localhost:6379"

# ==============================================
# APPLICATION  [ACTIVE]
# ==============================================
NODE_ENV="development"
HOST="0.0.0.0"
PORT=4000

# Comma-separated — supports a Lovable preview domain + production domain
# at the same time, e.g. "http://localhost:3000,https://your-preview.lovable.app"
CORS_ORIGIN="http://localhost:3000"

# ==============================================
# AUTHENTICATION  [ACTIVE]
# ==============================================
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-64-char-string-before-deploying"
JWT_EXPIRES_IN="7d"

# Exactly 32 characters — used as an AES-256 key for encrypting stored
# integration credentials (see apps/api/src/core/crypto.ts). Generate with:
# openssl rand -base64 24 | cut -c1-32
ENCRYPTION_KEY="change-me-to-exactly-32-chars!!"

# Telegram Login Widget — create a bot via @BotFather, this must be the
# same bot configured on your login widget for signature verification to pass.
TELEGRAM_BOT_TOKEN=""

# Google OAuth  [PHASE 2 — googleCallback() is currently a stub]
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ==============================================
# EMAIL PROVIDERS  [PHASE 2 — no sending module built yet]
# ==============================================
RESEND_API_KEY=""
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ==============================================
# SMS / TWILIO  [PHASE 2]
# ==============================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ==============================================
# VIBER  [PHASE 2]
# ==============================================
VIBER_AUTH_TOKEN=""
VIBER_BOT_NAME=""

# ==============================================
# PABBLY SUBSCRIPTION BILLING  [PHASE 2 — no webhook receiver built yet]
# ==============================================
PABBLY_API_KEY=""
PABBLY_WEBHOOK_SECRET=""

# ==============================================
# FILE STORAGE  [PHASE 2]
# ==============================================
UPLOAD_MAX_SIZE=10485760

# ==============================================
# RATE LIMITING  [ACTIVE]
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# MASTER ADMIN  [ACTIVE — read by db:seed]
# ==============================================
MASTER_ADMIN_EMAIL="admin@marketflow.com"
# Must NOT be left as the shipped default in production — the API refuses
# to boot with NODE_ENV=production if it detects this placeholder value.
MASTER_ADMIN_PASSWORD="change-me-before-production"

# ==============================================
# LOGGING  [ACTIVE]
# ==============================================
LOG_LEVEL="info" # error|warn|info|debug
LOG_FILE_PATH="./logs"
